# Supabase — project settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Seed script ONLY. Never imported by anything under src/.
# Not set in Cloudflare — the runtime authorises through the admin's own session.
SUPABASE_SERVICE_ROLE_KEY=

# Contact form -> email (Resend). Set in Cloudflare as a Worker SECRET, not a
# build variable: it is read at request time by the enquiry server action, and
# it must never reach the browser bundle.
RESEND_API_KEY=

# Optional. The From label on enquiry emails — a sender identity, not a mailbox,
# and nothing is ever sent FROM the inbox that receives enquiries (brand.email in
# src/lib/brand.ts). Must sit on a domain verified for sending in Resend.
# Defaults to "BM Website <website@bmcl.au>".
ENQUIRY_FROM=
